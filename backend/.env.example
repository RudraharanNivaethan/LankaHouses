HOST_DEV=127.0.0.1
PORT_DEV=3000
FRONTEND_URL_DEV=http://localhost:5173
FRONTEND_URL_PROD=
MONGODB_URI_DEV=

CUSTOMER_JWT_SECRET_DEV=
CUSTOMER_REFRESH_JWT_SECRET_DEV=

ADMIN_JWT_SECRET_DEV=
ADMIN_REFRESH_JWT_SECRET_DEV=

SUPER_ADMIN_JWT_SECRET_DEV=
SUPER_ADMIN_REFRESH_JWT_SECRET_DEV=

FIREBASE_SERVICE_ACCOUNT_PATH_DEV=secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH_PROD=

FIREBASE_WEB_API_KEY_DEV=

ADMIN_FULLNAME_DEV=
ADMIN_EMAIL_DEV=
ADMIN_PASSWORD_DEV=

SUPER_ADMIN_FULLNAME_DEV=
SUPER_ADMIN_EMAIL_DEV=
SUPER_ADMIN_PASSWORD_DEV=

SUPER_ADMIN_FULLNAME_PROD=
SUPER_ADMIN_EMAIL_PROD=
SUPER_ADMIN_PASSWORD_PROD=

NODE_ENV=development

# Cloudinary (image upload)
CLOUDINARY_CLOUD_NAME_DEV=
CLOUDINARY_API_KEY_DEV=
CLOUDINARY_API_SECRET_DEV=
CLOUDINARY_CLOUD_NAME_PROD=
CLOUDINARY_API_KEY_PROD=
CLOUDINARY_API_SECRET_PROD=

# Production server
HOST_PROD=
PORT_PROD=
MONGODB_URI_PROD=

# GET /api/property?search=… tiered limit window (ms). Per window: guest 10, user 30, admin 100.
PROPERTY_LIST_SEARCH_WINDOW_MS=60000

# GET /api/property without search — max list reads per IP per window (ms).
PROPERTY_LIST_READ_WINDOW_MS=60000
PROPERTY_LIST_READ_MAX=60

# GET /api/property/:id — max detail reads per IP per window (ms).
PROPERTY_BY_ID_READ_WINDOW_MS=60000
PROPERTY_BY_ID_READ_MAX=60

# Observability
SENTRY_DSN_DEV=
SENTRY_DSN_PROD=
LOG_LEVEL=info
