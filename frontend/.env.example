# Set to 'production' or 'development'. Overrides Vite MODE for Firebase project selection.
# Must match NODE_ENV on the backend to avoid Firebase token verification failures.
VITE_APP_ENV=development

# Firebase client — development (Vite MODE=development)
VITE_FIREBASE_API_KEY_DEV=
VITE_FIREBASE_AUTH_DOMAIN_DEV=
VITE_FIREBASE_PROJECT_ID_DEV=
VITE_FIREBASE_STORAGE_BUCKET_DEV=
VITE_FIREBASE_MESSAGING_SENDER_ID_DEV=
VITE_FIREBASE_APP_ID_DEV=

# Firebase client — production build (Vite MODE=production)
VITE_FIREBASE_API_KEY_PROD=
VITE_FIREBASE_AUTH_DOMAIN_PROD=
VITE_FIREBASE_PROJECT_ID_PROD=
VITE_FIREBASE_STORAGE_BUCKET_PROD=
VITE_FIREBASE_MESSAGING_SENDER_ID_PROD=
VITE_FIREBASE_APP_ID_PROD=

# Debounce (ms) before property list search runs after user stops typing (150–3000, default 700)
VITE_SEARCH_DEBOUNCE_MS_DEV=700
VITE_SEARCH_DEBOUNCE_MS_PROD=700

# Backend API base URL (no trailing slash). Defaults are used when these are unset.
# DEV  default: http://localhost:8080/api
# PROD default: https://backend-production-5de3.up.railway.app/api
VITE_API_BASE_URL_DEV=http://localhost:8080/api
VITE_API_BASE_URL_PROD=https://backend-production-5de3.up.railway.app/api
